APP_APP_NAME="FastAPI App"
APP_VERSION=0.1.0
APP_DEBUG=true
# 全局日志级别（app 与 uvicorn 统一格式，日志行带请求 ID）：DEBUG|INFO|WARNING|ERROR
# APP_LOG_LEVEL=INFO
# /metrics 访问令牌（Prometheus 等抓取器带 Authorization: Bearer 或
# X-Metrics-Token）；留空 = 不鉴权，公网暴露时务必配置
# APP_METRICS_TOKEN=
APP_CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# SQLite by default (file in project root).
APP_DATABASE_URL=sqlite+aiosqlite:///./app.db
APP_DB_ECHO=false
# Postgres in production (requires asyncpg):
# APP_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/app

# --- 数据源连接串加密（Fernet）---
# 外部数据源（智能问数）的连接串落库前用此密钥加密。留空时由
# APP_ADMIN_API_KEY 派生确定值（开箱即用）；生产建议显式配一个随机串，
# 配法：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 注意：换 key 后存量密文无法解回，需重新录入数据源。
# APP_DATASOURCE_SECRET_KEY=

# --- Access control ---
# 首次引导密钥：只能用于 POST /admin/onboard（创建库里第一个超级管理员）。
# RBAC 后它不再是任何管理接口的旁路；置空 = 关闭 HTTP 引导，
# 只能走 CLI：python -m app.bootstrap seed --username admin --password xxx
# 生产环境请改掉默认值（引导完成后可以放心换掉或置空）。
APP_ADMIN_API_KEY=admin-dev-key

# --- 登录限流（进程内滑窗，多 Worker 时阈值≈配置值×进程数）---
# 同一「IP+用户名」在窗口内最多 max_attempts 次登录尝试；lockout 窗内
# 累计 threshold 次口令错误即锁定（login 与 onboard 引导密钥都受护）。
# APP_LOGIN_RATE_LIMIT_ENABLED=true
# APP_LOGIN_WINDOW_SECONDS=60
# APP_LOGIN_MAX_ATTEMPTS=10
# APP_LOGIN_LOCK_THRESHOLD=5
# APP_LOGIN_LOCKOUT_SECONDS=900

# --- 后台巡检（增长型表保留清理，见 app/housekeeping.py）---
# 启动时同步跑一次 + 之后按 interval 周期跑：删终态（success/failed）超保留
# 天数的 rag_tasks 行、已过期（expires_at 早于现在）的 admin_sessions 行。
# APP_HOUSEKEEPING_ENABLED=true
# APP_HOUSEKEEPING_INTERVAL_SECONDS=86400
# APP_RAG_TASK_RETENTION_DAYS=30

# --- AI / LLM ---
# The provider used when a request does not specify one.
# Supported: openai | deepseek | qwen | ollama | mlx | mock
APP_LLM_DEFAULT_PROVIDER=mock

# --- LLM 调用重试与降级 ---
# 对瞬时故障（超时/连接失败/429/5xx）指数退避重试；4xx 参数与鉴权错不重试。
# 包含首次在内的最大尝试次数
# APP_LLM_RETRY_MAX_ATTEMPTS=3
# 退避：第 n 次失败后等 min(base * 2^n, max) 秒
# APP_LLM_RETRY_BACKOFF_BASE=1.0
# APP_LLM_RETRY_BACKOFF_MAX=10
# 非流式对话在主 provider 重试耗尽后改问的备胎（留空 = 关闭）。
# 只影响 chat：流式不中途偷换，嵌入换模型会打乱向量空间。
# APP_LLM_FALLBACK_PROVIDER=deepseek

# --- Per-provider configs ---
# Each provider has its own api_key / base_url / chat_model / embedding_model.
# Set only what you use; leave the rest at the in-code defaults.

# OpenAI (https://platform.openai.com)
# APP_LLM_OPENAI_API_KEY=sk-xxx
# APP_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# APP_LLM_OPENAI_CHAT_MODEL=gpt-4o-mini
# APP_LLM_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek (https://www.deepseek.com)
# APP_LLM_DEEPSEEK_API_KEY=sk-xxx
# APP_LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# APP_LLM_DEEPSEEK_CHAT_MODEL=deepseek-chat
# APP_LLM_DEEPSEEK_EMBEDDING_MODEL=deepseek-embed

# Qwen / 通义 (https://dashscope.aliyun.com, OpenAI-compatible)
# APP_LLM_QWEN_API_KEY=sk-xxx
# APP_LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# APP_LLM_QWEN_CHAT_MODEL=qwen-plus
# APP_LLM_QWEN_EMBEDDING_MODEL=text-embedding-v3

# Ollama (local, https://ollama.com)
# APP_LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
# APP_LLM_OLLAMA_CHAT_MODEL=llama3.1
# APP_LLM_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# MLX (local, https://github.com/ml-explore/mlx-lm)
# 模型名/端口/密钥因机器而异，必须在此配置；代码不再内置任何真实环境值
# APP_LLM_MLX_BASE_URL=http://localhost:8080/v1
# APP_LLM_MLX_CHAT_MODEL=<你的服务里加载的模型名>
# APP_LLM_MLX_EMBEDDING_MODEL=<你的服务里加载的嵌入模型名>
# APP_LLM_MLX_API_KEY=<本地服务的 Bearer，部分服务接受任意值>

# Mock (offline; deterministic echo + hash embeddings; no key required)
# APP_LLM_MOCK_CHAT_MODEL=mock-chat
# APP_LLM_MOCK_EMBEDDING_MODEL=mock-embed

# --- RAG / 向量检索 ---
# knowledge_chunks.vector 的列维度，必须与 embedding 模型输出一致
# （Postgres 上是 vector(<dim>) + HNSW 索引；改维度后要重跑 alembic upgrade head）
APP_RAG_VECTOR_DIM=1024

# RAG 后台队列的并发 Worker 数（录入/更新/重建等写入类操作异步执行）。
# 单 Worker 时一个大文档会堵住整条队列；也不宜过大（向量化是外部 HTTP/本地
# 模型调用，并行太多会打满下游）。任务已落库 rag_tasks，可用 task_id 轮询状态。
# APP_RAG_QUEUE_WORKERS=2

# --- RAG 精排（cross-encoder rerank，两段式检索）---
# 开启后：向量先宽召回 recall_k=top_k*multiplier 条，再调 rerank 模型精排取 top_k。
# 端点用 OpenAI/Cohere 风格 POST {base_url}/rerank（Xinference / SiliconFlow / TEI 兼容层）。
# 关掉（默认）或调用失败时自动回退纯向量排序，不影响可用性。
# APP_RAG_RERANK_ENABLED=true
# APP_RAG_RERANK_BASE_URL=http://localhost:8089/v1
# APP_RAG_RERANK_MODEL=bge-reranker-v2-m3
# APP_RAG_RERANK_API_KEY=
# APP_RAG_RERANK_RECALL_MULTIPLIER=5
# 低于此精排分的候选丢弃（阈值需按所用模型标定，默认 0 不过滤）
# APP_RAG_RERANK_MIN_SCORE=0.0
# APP_RAG_RERANK_TIMEOUT=10

# --- RAG 混合检索（向量 + 全文词法，RRF 融合）---
# 开启后（仅 Postgres）：向量召回 + pg_trgm 词法召回 → RRF 融合 →（若启用）交给 reranker。
# 词法腿用 pg_trgm 的 word_similarity（三元组，对中文无需分词），需先跑
# alembic upgrade head 建扩展与 GIN trigram 索引（app 启动也会尝试建）。
# 关掉（默认）、非 Postgres、或 pg_trgm 不可用时，自动退回纯向量。
# APP_RAG_HYBRID_ENABLED=true
# RRF 公式 1/(k+rank) 的平滑常量，业界默认 60；越大越弱化头部排名优势
# APP_RAG_HYBRID_RRF_K=60
# 向量腿权重，词法腿为 1-该值（0.5 = 两腿等权）
# APP_RAG_HYBRID_VECTOR_WEIGHT=0.5
# 词法召回候选上限（按三元组相似度降序）
# APP_RAG_HYBRID_TEXT_TOPK=20

# --- 数据分析（Text-to-SQL 智能问数）---
# 独立功能：自然语言 → 只读 SQL → 执行 → AI 结论。
# 接口需 analytics:read 权限（见 app/rbac.py）；生成的 SQL 强校验为只读（仅 SELECT/WITH），
# 执行走独立连接的只读事务兜底，凭证列（password/token/api_key…）从 schema 与结果里屏蔽。
# 默认开启；置 false 则 /api/v1/analytics/* 返回 403。
# APP_ANALYTICS_ENABLED=true
# 单次问数最多返回多少行（超出截断并置 truncated，同时决定喂给总结模型的行数）
# APP_ANALYTICS_MAX_ROWS=200
# Postgres 语句超时（秒），防止烂 SQL 跑挂库
# APP_ANALYTICS_TIMEOUT_SECONDS=15
# 永不暴露也不进模型上下文的数据表（逗号分隔的 JSON 数组）
# APP_ANALYTICS_DENIED_TABLES=["alembic_version"]
# 敏感列名（子串匹配）：即使 SELECT * 命中也会从结果行与 schema 上下文里抹掉
# APP_ANALYTICS_SECRET_COLUMNS=["password","password_hash","token","token_hash","api_key","secret"]

# --- 上传的图片存储 ---
# 图片落盘为文件、经 StaticFiles 直接对外服务，数据库只存 URL（不再塞 base64）。
# media_dir 可为相对仓库根的路径或绝对路径；media_url 为对外访问前缀。
# APP_MEDIA_DIR=media
# APP_MEDIA_URL=/media

# --- 博客对外基址（RSS /feed 与 sitemap.xml 里的绝对链接）---
# 留空时从请求头推断（反代后常不准）；生产显式配公开访问域名。
# APP_SITE_URL=https://blog.example.com

# --- 联网检索（给对话模型挂 web_search / fetch_page 工具）---
# 总开关：关掉后 /ai/chat 不再向模型声明任何工具，模型只能凭参数知识回答。
# APP_WEB_SEARCH_ENABLED=true
# 搜索源：tavily | serper | bing。选 tavily/serper 但没配 key 时自动退回 bing 免 key
# 抓取（能跑，但 HTML 一改版就哑，只当兜底），并在回答里说明用的是兜底源。
# APP_WEB_SEARCH_PROVIDER=tavily
# 申请：tavily https://app.tavily.com （有免费额度）；serper https://serper.dev
# APP_WEB_SEARCH_API_KEY=
# 走自建网关/代理时覆盖，留空用官方地址
# APP_WEB_SEARCH_BASE_URL=
# 单次搜索返回条数（也是回喂给模型的条数上限）
# APP_WEB_SEARCH_MAX_RESULTS=5
# APP_WEB_SEARCH_TIMEOUT_SECONDS=12
# 摘要进 prompt 前的截断长度（不截会让 token 随条数线性膨胀）
# APP_WEB_SEARCH_SNIPPET_CHARS=500
# 一次提问允许多少个「模型要求调工具」的回合，超出就强制基于已有信息作答
# APP_WEB_SEARCH_MAX_ROUNDS=3
# 相同查询在该秒数内复用缓存，避免重复烧搜索额度（0 表示不缓存）
# APP_WEB_SEARCH_CACHE_TTL_SECONDS=600
# fetch_page 工具的单页约束
# APP_WEB_FETCH_TIMEOUT_SECONDS=15
# APP_WEB_FETCH_MAX_CHARS=6000
# 默认拒绝内网/回环地址（模型可能被网页内容诱导去打 SSRF）；闸门含
# DNS 解析后校验与重定向逐跳复检，仅调试内网 wiki 时才建议放开
# APP_WEB_FETCH_ALLOW_PRIVATE=false
